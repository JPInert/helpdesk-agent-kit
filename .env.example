# Copy to .env and fill in only what you use. Nothing here is needed for the offline demo.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_VIEW_ID=
ANTHROPIC_API_KEY=
HDK_MODEL=claude-opus-5-5
PORTAL_URL=http://127.0.0.1:8750
PORTAL_USER=demo
PORTAL_PASSWORD=demo-password
STAFF_DOMAIN=example-corp.test
# The other two mock systems. Leave empty to leave an adapter out of the run.
APPROVALS_URL=
SESSIONS_URL=
# Review dashboard: set a random value of at least 16 characters. There is no default and the dashboard will not start without one.
DASHBOARD_TOKEN=
